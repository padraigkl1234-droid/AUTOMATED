# ---- Content generation ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Data sources ----
# https://www.football-data.org/client/register  (free tier: 10 req/min)
FOOTBALL_DATA_TOKEN=

# ---- Instagram (Graph API) ----
# IG account must be Business or Creator, linked to a Facebook Page.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---- TikTok (Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# ---- Media hosting ----
# Instagram will not accept local files: it fetches media from a public URL.
# Any static host works (S3, R2, GitHub Pages, Bunny).
MEDIA_BASE_URL=https://cdn.example.com/football
MEDIA_UPLOAD_DIR=./out

# ---- Safety ----
# never | drafts | auto   -- see docs/RUNBOOK.md
PUBLISH_MODE=drafts

# Comma-separated: instagram, tiktok, or both. Leave TikTok out until you
# have credentials / have passed the API audit -- see docs/RUNBOOK.md.
PLATFORMS=instagram
